{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Supabase (local)",
      "type": "shell",
      "command": "supabase start",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "close": true
      }
    },
    {
      "label": "Stop Supabase (local)",
      "type": "shell",
      "command": "supabase stop",
      "problemMatcher": [],
      "presentation": {
        "close": true
      }
    },
    {
      "label": "Start Vite",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Dev: Start All",
      "dependsOn": ["Start Supabase (local)", "Start Vite"],
      "dependsOrder": "parallel"
    },
    {
      "label": "Dev: Stop All",
      "dependsOn": ["Stop Supabase (local)"],
      "problemMatcher": []
    },
    {
      "label": "Generate Types from Supabase",
      "type": "shell",
      "command": "supabase gen types typescript --local > ./frontend/src/lib/database.types.ts",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      }
    },
    {
      "label": "Generate Migration File",
      "type": "shell",
      "command": "supabase db diff --local -f ${input:migrationName}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "close": true
      }
    }
  ],
  "inputs": [
    {
      "id": "migrationName",
      "type": "promptString",
      "description": "Enter the migration name",
      "default": "new_migration"
    }
  ]
}
